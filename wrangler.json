{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "progetalms",
	"compatibility_date": "2024-03-20",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"triggers": {
		"crons": ["30 16 * * *"]
	},
	"observability": {
		"enabled": true
	}
}
