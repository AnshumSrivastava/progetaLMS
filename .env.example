# =============================================================================
# Launchpad — Environment Variables
# Progeta Technologies · lms.progeta.in
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ALL variables listed here are REQUIRED unless marked [optional].
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The public URL of your app (no trailing slash)
PUBLIC_APP_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cashfree ──────────────────────────────────────────────────────────────────
# Credentials from: https://merchant.cashfree.com/merchants/developer
# Note: CASHFREE_SECRET_KEY is also used for webhook signature verification (API v3).
# No separate webhook secret is required.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'sandbox' for testing, 'production' for live
CASHFREE_ENV=sandbox

# ── Resend (Email) ────────────────────────────────────────────────────────────
# API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified domain in your Resend account
RESEND_FROM_ADDRESS=Launchpad <noreply@progeta.in>

# ── File Storage ──────────────────────────────────────────────────────────────
# Provider selection: local | r2 | supabase
# Default: local (no cloud account required for development)
UPLOAD_PROVIDER=local

# ── Local Storage (UPLOAD_PROVIDER=local) ────────────────────────────────────
# Directory where uploaded files are stored (relative to project root)
UPLOAD_DIRECTORY=./uploads
# Base URL where uploaded files are publicly served
PUBLIC_UPLOAD_URL=/uploads

# ── Cloudflare R2 (UPLOAD_PROVIDER=r2) ───────────────────────────────────────
# Activate by setting UPLOAD_PROVIDER=r2 and filling in these values.
# Run: MIGRATE_FROM=local MIGRATE_TO=r2 npx tsx scripts/migrate-storage.ts
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=launchpad-assets
# R2_PUBLIC_URL=https://assets.progeta.in

# ── Supabase Storage (UPLOAD_PROVIDER=supabase) ───────────────────────────────
# Activate by setting UPLOAD_PROVIDER=supabase and filling in these values.
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_STORAGE_BUCKET=launchpad-assets
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ───────────────────────────────────────────────────────────────────────
PUBLIC_APP_NAME=Launchpad
